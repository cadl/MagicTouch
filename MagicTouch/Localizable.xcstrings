          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 승인 필요"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要在系统设置中批准"
          }
        }
      }
    },
    "alert.moveToApplications.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please move MagicTouch to the Applications folder to enable Launch at Login. This is required by macOS for security."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueva MagicTouch a la carpeta Aplicaciones para habilitar el inicio automático. Esto es un requisito de seguridad de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez déplacer MagicTouch vers le dossier Applications pour activer le lancement au démarrage. C'est une exigence de sécurité de macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン時に起動を有効にするには、MagicTouch をアプリケーションフォルダに移動してください。これは macOS のセキュリティ要件です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 시 실행을 활성화하려면 MagicTouch를 응용 프로그램 폴더로 이동하세요. 이는 macOS 보안 요구사항입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请将 MagicTouch 移动到「应用程序」文件夹后再启用开机启动。这是 macOS 的安全要求。"
          }
        }
      }
    },
