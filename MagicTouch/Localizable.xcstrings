    "alert.launchAtLogin.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launch at Login requires manual approval in the Login Items section of System Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir al iniciar sesión requiere aprobación manual en la sección Elementos de inicio de sesión de Configuración del Sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lancement au démarrage nécessite une approbation manuelle dans la section Ouverture des Réglages Système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ログイン時に起動」はシステム設定の「ログイン項目」で手動承認が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 시 실행은 시스템 설정의 로그인 항목에서 수동 승인이 필요합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开机启动需要在系统设置的「登录项」中手动批准。"
          }
        }
      }
    },
    "alert.launchAtLogin.openSettings" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
