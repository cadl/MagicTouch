    "main.picker.clickMode.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L/R: Left side → Left click, Right side → Right click\nLeft: Any position → Left click"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I/D: Lado izquierdo → Clic izquierdo, Lado derecho → Clic derecho\nIzquierdo: Cualquier posición → Clic izquierdo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "G/D : Côté gauche → Clic gauche, Côté droit → Clic droit\nGauche : Toute position → Clic gauche"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左/右：左側 → 左クリック、右側 → 右クリック\n左：任意の位置 → 左クリック"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좌/우: 왼쪽 → 왼쪽 클릭, 오른쪽 → 오른쪽 클릭\n왼쪽: 모든 위치 → 왼쪽 클릭"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左/右：左侧触摸 → 左键点击，右侧触摸 → 右键点击\n左键：任意位置 → 左键点击"
          }
        }
      }
    },
